{
  "pipeline": [
    {
      "type": "readers.las",
      "filename": "data/processed/hag_72.laz"
    },
    {
      "type": "filters.expression",
      "expression": "HeightAboveGround >= 0"
    },
    {
      "type": "writers.gdal",
      "filename": "data/processed/chm_72.tif",
      "dimension": "HeightAboveGround",
      "resolution": 1.0,
      "output_type": "max",
      "gdaldriver": "GTiff",
      "nodata": -9999
    }
  ]
}